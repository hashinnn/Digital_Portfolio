{
  "name": "hasini-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio of Ginjala Hasini — React front end served by an Express API.",
  "engines": { "node": ">=20" },
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js",
    "postinstall": "npm --prefix client install"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
